        "#Se hace la importación de librerías necesarias para poder realizar visualizaciones importantes\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "import plotly.graph_objects as go\n",
        "import numpy as np\n",
        "import warnings\n",
        "import random\n",
        "import matplotlib.pyplot as plt\n",
        "from wordcloud import WordCloud\n",
        "\n",
        "#Fijamos una semilla para que los resultados sean reproducibles\n",
        "random.seed(42)\n",
        "\n",
        "#Se define una variable para manejar errores\n",
        "error_mode = False\n",
        "#Implementación de try-except para manejar errores\n",
        "try:\n",
        "    #Se cargan los datos previamente manejados en el notebook de preprocesamiento\n",
        "    df_limpio = pd.read_parquet('../datos/dataset_limpio_modelo.parquet')\n",
        "    df_limpio['fecha'] = pd.to_datetime(df_limpio['fecha'])\n",
        "    df_limpio['nivel_hidrico_pct'] = df_limpio['nivel_hidrico_pct'] * 100\n",
        "    #Se agrupan los datos por fecha y se calcula el promedio de los niveles hídricos\n",
        "    df_actual = df_limpio.groupby('fecha').mean(numeric_only=True).reset_index()\n",
        "    #Se obtiene el último nivel hídrico\n",
        "    ultimo_nivel = df_actual['nivel_hidrico_pct'].iloc[-1]\n",
        "\n",
        "    #Se cargan las predicciones oficiales, referentes al modelo Transformer construido por UPIIT Machine\n",
        "    df_proyecciones = pd.read_csv('../datos/predicciones_finales_smn.csv')\n",
        "    for col in ['pred_pct_Base', 'pred_pct_Temp_+1C', 'pred_pct_Temp_+2C', 'pred_pct_Temp_+3C']:\n",
        "        if col in df_proyecciones.columns:\n",
        "            df_proyecciones[col] = df_proyecciones[col] * 100\n",
        "    #Se obtiene la predicción promedio de los niveles hídricos\n",
        "    prediccion_IA = df_proyecciones['pred_pct_Base'].mean()\n",
        "\n",
        "    #Se crea una columna con el año y mes para facilitar el agrupamiento\n",
        "    df_limpio['año_mes'] = df_limpio['fecha'].dt.to_period('M').astype(str)\n",
        "    #Se agrupan los datos por año y mes, además de la presa, latitud y longitud, y se calcula el promedio de los niveles hídricos\n",
        "    agrupado_geo = df_limpio.groupby(\n",
        "        ['año_mes', 'nombre_presa', 'latitud', 'longitud']\n",
        "    ).mean(numeric_only=True).reset_index()\n",
        "    #Aquí obtiene el último nivel hídrico\n",
        "    # Selecciona la última fecha reportada INDIVIDUALMENTE por cada presa\n",
        "    ultimos = df_limpio[df_limpio.fecha == df_limpio.fecha.max()].copy()\n",
        "\n",
        "    #Se calcula el nivel actual\n",
        "    nivel_actual = ultimos['nivel_hidrico_pct'].mean()\n",
        "    #Se calcula el porcentaje de presas en niveles críticos y óptimos\n",
        "    if len(ultimos) > 0:\n",
        "        #Se calcula el porcentaje de presas en niveles críticos (10% o menos)\n",
        "        pct_critico = (len(ultimos[ultimos['nivel_hidrico_pct'] < 10]) / len(ultimos)) * 100\n",
        "        #Se calcula el porcentaje de presas en niveles óptimos (50% o más)  \n",
        "        pct_optimo  = (len(ultimos[ultimos['nivel_hidrico_pct'] > 50]) / len(ultimos)) * 100\n",
        "    else:\n",
        "        pct_critico, pct_optimo = 0, 0\n",
        "    #Obtención de fechas para el cálculo de la variación entre años\n",
        "    ultimo_año_fecha = df_limpio['fecha'].max()\n",
        "    hace_un_año = ultimo_año_fecha - pd.DateOffset(years=1)\n",
        "    hace_dos_años = ultimo_año_fecha - pd.DateOffset(years=2)\n",
        "    #Cálculo del promedio de los niveles hídricos en el último año y en el año anterior\n",
        "    promedio_ultimo_año = df_limpio[(df_limpio['fecha'] > hace_un_año) & (df_limpio['fecha'] <= ultimo_año_fecha)]['nivel_hidrico_pct'].mean()\n",
        "    promedio_año_anterior = df_limpio[(df_limpio['fecha'] > hace_dos_años) & (df_limpio['fecha'] <= hace_un_año)]['nivel_hidrico_pct'].mean()\n",
        "    #Cálculo de la variación entre años \n",
        "    variacion_interanual = promedio_ultimo_año - promedio_año_anterior\n",
        "    #Cálculo del promedio global de los niveles hídricos\n",
        "    promedio_global = df_limpio['nivel_hidrico_pct'].mean()\n",
        "    #Cálculo de la desviación global de los niveles hídricos respecto al promedio global\n",
        "    desviacion_global = nivel_actual - promedio_global\n",
        "    #Cálculo del promedio de las predicciones del modelo Transformer    \n",
        "    pred_promedio_ia = df_proyecciones['pred_pct_Base'].mean()\n",
        "    #Cálculo del impacto climático en los niveles hídricos\n",
        "    impacto_climatico_ia = (df_proyecciones['pred_pct_Temp_+2C'] - df_proyecciones['pred_pct_Base']).mean()\n",
        "    #Cálculo del porcentaje de presas en niveles críticos según las predicciones del modelo Transformer\n",
        "    if len(df_proyecciones) > 0:\n",
        "        pct_colapso_ia = (len(df_proyecciones[df_proyecciones['pred_pct_Temp_+2C'] < 45]) / len(df_proyecciones)) * 100\n",
        "    else:\n",
        "        pct_colapso_ia = 0\n",
        "        \n",
        "    df_limpio['año'] = df_limpio['fecha'].dt.year\n",
        "    año_mas_critico = int(df_limpio.groupby('año')['nivel_hidrico_pct'].mean().idxmin())\n",
        "    volatilidad_sistema = df_limpio['nivel_hidrico_pct'].std()\n",
        "    \n",
        "    fechas_ordinales = df_actual['fecha'].apply(lambda x: x.toordinal())\n",
        "    pendiente_diaria, _ = np.polyfit(fechas_ordinales, df_actual['nivel_hidrico_pct'], 1)\n",
        "    pendiente_tendencia = pendiente_diaria * 365.25\n",
        "    \n",
        "    hace_5_años = ultimo_año_fecha - pd.DateOffset(years=5)\n",
        "    prom_5y_atras = df_limpio[(df_limpio['fecha'] > hace_5_años - pd.DateOffset(years=1)) & (df_limpio['fecha'] <= hace_5_años)]['nivel_hidrico_pct'].mean()\n",
        "    if pd.isna(prom_5y_atras): prom_5y_atras = promedio_global\n",
        "    cambio_5_años = promedio_ultimo_año - prom_5y_atras\n",
        "\n",
        "    # Animación Nacional Stats\n",
        "    if 'estado_id' in df_limpio.columns:\n",
        "        promedio_estado = df_limpio.groupby('estado_id')['nivel_hidrico_pct'].mean()\n",
        "        estado_menor_nivel = promedio_estado.idxmin().split('-')[-1]\n",
        "        \n",
        "        primeros_años = df_limpio['fecha'].min() + pd.DateOffset(years=2)\n",
        "        ultimos_años = ultimo_año_fecha - pd.DateOffset(years=2)\n",
        "        prom_ini_est = df_limpio[df_limpio['fecha'] <= primeros_años].groupby('estado_id')['nivel_hidrico_pct'].mean()\n",
        "        prom_fin_est = df_limpio[df_limpio['fecha'] >= ultimos_años].groupby('estado_id')['nivel_hidrico_pct'].mean()\n",
        "        estado_mayor_caida = (prom_ini_est - prom_fin_est).idxmax().split('-')[-1]\n",
        "    else:\n",
        "        estado_menor_nivel, estado_mayor_caida = \"N/A\", \"N/A\"\n",
        "    \n",
        "    pct_critico_nacional = pct_critico\n",
        "    \n",
        "    promedio_hist_presa = df_limpio.groupby('nombre_presa')['nivel_hidrico_pct'].mean().reset_index()\n",
        "    promedio_hist_presa.rename(columns={'nivel_hidrico_pct': 'promedio_hst'}, inplace=True)\n",
        "    agrupado_geo = pd.merge(agrupado_geo, promedio_hist_presa, on='nombre_presa', how='left')\n",
        "    agrupado_geo['deterioro_historico'] = agrupado_geo['promedio_hst'] - agrupado_geo['nivel_hidrico_pct']\n",
        "    agrupado_geo['tamaño_deterioro'] = agrupado_geo['deterioro_historico'].clip(lower=1)\n",
        "\n",
        "except Exception as e:\n",
        "    error_mode = True\n",
        "    print(f\"I/O Exception: {str(e)}\")\n",
        "    df_actual = pd.DataFrame({\n",
        "        'fecha': pd.to_datetime(['2025-01-01', '2025-02-01']),\n",
        "        'nivel_hidrico_pct': [40, 30],\n",
        "        'temp_max_c': [30, 32]\n",
        "    })\n",
        "    df_proyecciones = pd.DataFrame({\n",
        "        'presa_id': [1, 2, 3],\n",
        "        'nombre_presa': ['NA', 'NA2', 'NA3'],\n",
        "        'latitud': [0, 0, 0],\n",
        "        'longitud': [0, 0, 0],\n",
        "        'pred_pct_Base': [50, 40, 30],\n",
        "        'pred_pct_Temp_+1C': [40, 30, 20],\n",
        "        'pred_pct_Temp_+2C': [30, 20, 10],\n",
        "        'pred_pct_Temp_+3C': [20, 10, 0]\n",
        "    })\n",
        "    nivel_actual         = 45.0\n",
        "    pct_critico          = 15.0\n",
        "    pct_optimo           = 10.0\n",
        "    variacion_interanual = -5.0\n",
        "    desviacion_global    = -10.0\n",
        "    pred_promedio_ia     = 40.0\n",
        "    impacto_climatico_ia = -8.0\n",
        "    pct_colapso_ia       = 25.0\n",
        "    año_mas_critico      = 2023\n",
        "    volatilidad_sistema  = 12.5\n",
        "    pendiente_tendencia  = -1.5\n",
        "    cambio_5_años        = -10.0\n",
        "    estado_menor_nivel   = \"SON\"\n",
        "    estado_mayor_caida   = \"AGU\"\n",
        "    pct_critico_nacional = 15.0\n",
        "    ultimos             = df_proyecciones.copy()\n",
        "    agrupado_geo        = df_proyecciones.copy()\n",
        "    agrupado_geo['tamaño_deterioro'] = 5"
      ],
