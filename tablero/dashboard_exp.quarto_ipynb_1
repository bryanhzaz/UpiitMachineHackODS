      "source": [
        "if not error_mode:\n",
        "    df_ultimos = ultimos[['presa_id', 'nivel_hidrico_pct']].copy()\n",
        "    df_ultimos = df_ultimos.groupby('presa_id').mean().reset_index()\n",
        "    \n",
        "    df_matriz = pd.merge(df_proyecciones, df_ultimos, on='presa_id', how='inner')\n",
        "    \n",
        "    umbral_x = 40\n",
        "    umbral_y = 20\n",
        "    \n",
        "    def clasificar_cuadrante(row):\n",
        "        h_actual = row['nivel_hidrico_pct']\n",
        "        h_futuro = row['pred_pct_Base']\n",
        "        if h_actual >= umbral_x and h_futuro >= umbral_y:\n",
        "            return \"Estables (Cota Alta)\"\n",
        "        elif h_actual >= umbral_x and h_futuro < umbral_y:\n",
        "            return \"Riesgo Futuro (Ahorro Urgente)\"\n",
        "        elif h_actual < umbral_x and h_futuro < umbral_y:\n",
        "            return \"Críticas (Emergencia)\"\n",
        "        else:\n",
        "            return \"Recuperación Improbable (No Prioridad)\"\n",
        "\n",
        "    df_matriz['Cuadrante'] = df_matriz.apply(clasificar_cuadrante, axis=1)\n",
        "    color_map = {\n",
        "        \"Estables (Cota Alta)\": \"#00cc96\", \n",
        "        \"Riesgo Futuro (Ahorro Urgente)\": \"#FFA15A\", \n",
        "        \"Críticas (Emergencia)\": \"#EF553B\", \n",
        "        \"Recuperación Improbable (No Prioridad)\": \"#ab63fa\"\n",
        "    }\n",
        "\n",
        "    fig_matriz = px.scatter(\n",
        "        df_matriz, x=\"nivel_hidrico_pct\", y=\"pred_pct_Base\",\n",
        "        color=\"Cuadrante\", color_discrete_map=color_map,\n",
